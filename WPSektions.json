            { "key": "field_service_highlight_1", "label": "Highlight 1 (z.B. 24/7 Tracking)", "name": "highlight_1", "type": "text", "wrapper": { "width": "33.33" } },
            { "key": "field_service_highlight_2", "label": "Highlight 2 (z.B. 99.2% Pünktlich)", "name": "highlight_2", "type": "text", "wrapper": { "width": "33.33" } },
            { "key": "field_service_highlight_3", "label": "Highlight 3 (z.B. 5 Mio EUR Vers.)", "name": "highlight_3", "type": "text" },
            
