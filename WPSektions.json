                { "key": "field_main_button_text", "label": "Text", "name": "text", "type": "text", "wrapper": { "width": "50" } },
                { "key": "field_main_button_link_to", "label": "Link-ID", "name": "link_to", "type": "text", "instructions": "CSS ID zum Scrollen (z.B. 'kontakt').", "wrapper": { "width": "50" } }
              ]
            },
            {
              "key": "field_hero_secondary_button", "label": "Sekundär-Button", "name": "secondary_button", "type": "group",
              "sub_fields": [
                { "key": "field_secondary_button_text", "label": "Text", "name": "text", "type": "text", "wrapper": { "width": "50" } },
                { "key": "field_secondary_button_link_to", "label": "Link-ID", "name": "link_to", "type": "text", "instructions": "CSS ID zum Scrollen (z.B. 'services').", "wrapper": { "width": "50" } }
              ]
