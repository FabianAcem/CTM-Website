                { "key": "field_service_card_icon", "label": "Icon", "name": "icon", "type": "text", "wrapper": { "width": "20" } },
                { "key": "field_service_card_title", "label": "Titel", "name": "title", "type": "text", "wrapper": { "width": "30" } },
                { "key": "field_service_card_description", "label": "Beschreibung", "name": "description", "type": "textarea", "rows": 2, "wrapper": { "width": "30" } },
                { "key": "field_service_card_highlight", "label": "Highlight Text", "name": "highlight", "type": "text", "wrapper": { "width": "20" } } // highlight-Feld hinzugefügt
              ]
