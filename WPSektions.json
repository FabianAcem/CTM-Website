{
  "key": "group_page_content",
  "title": "Seiteninhalte (Flexible Content)",
  "fields": [
    {
      "key": "field_page_flexible_content",
      "label": "Seiteninhalt",
      "name": "page_content",
      "type": "flexible_content",
      "layouts": [
        // --- LAYOUT 1: HERO SEKTION (wie zuvor, da korrekt) ---
        {
          "key": "layout_hero_section",
          "name": "hero_section",
          "label": "1. Hero Sektion (Start)",
          "display": "block",
          "sub_fields": [
            { "key": "field_hero_content_tab", "label": "Inhalte", "name": "", "type": "tab", "placement": "top" },
            { "key": "field_hero_tagline", "label": "Tagline (Oberer Text)", "name": "tagline", "type": "text", "wrapper": { "width": "50" } },
            { "key": "field_hero_headline", "label": "Titel (H1)", "name": "headline", "type": "textarea", "rows": 2 },
            { "key": "field_hero_subtext", "label": "Untertext", "name": "subtext", "type": "textarea", "rows": 3 },
            { "key": "field_hero_footer_text", "label": "Fußzeile (Kleiner Text unten)", "name": "footer_text", "type": "text" },
            { "key": "field_hero_buttons_tab", "label": "Buttons", "name": "", "type": "tab", "placement": "top" },
            {
              "key": "field_hero_main_button", "label": "Haupt-Button", "name": "main_button", "type": "group",
