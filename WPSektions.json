            { "key": "field_services_cta", "label": "Sektions-CTA", "name": "cta", "type": "group",
              "sub_fields": [
                { "key": "field_services_cta_text", "label": "CTA Text", "name": "text", "type": "text", "wrapper": { "width": "50" } },
