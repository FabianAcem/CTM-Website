              "sub_fields": [
                { "key": "field_email_label", "label": "Label", "name": "label", "type": "text", "wrapper": { "width": "40" } },
                { "key": "field_email_address", "label": "Adresse", "name": "address", "type": "email", "wrapper": { "width": "60" } }
              ]
            },

            // Öffnungszeiten & Verfügbarkeit
            { "key": "field_contact_hours_tab", "label": "Öffnungszeiten & Impr.", "name": "", "type": "tab", "placement": "top" },
            { "key": "field_contact_office_hours", "label": "Öffnungszeiten (officeHours)", "name": "officeHours", "type": "repeater", "layout": "table", "button_label": "Zeile hinzufügen",
