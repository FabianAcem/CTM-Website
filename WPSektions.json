            { "key": "field_contact_recipient", "label": "Haupt-Empfänger E-Mail", "name": "recipient", "type": "email", "instructions": "Standard-Empfänger für das Formular." },
            { "key": "field_contact_cc", "label": "CC E-Mail", "name": "cc", "type": "email" },
            
