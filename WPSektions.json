            { "key": "field_hero_cards_tab", "label": "Highlight Kacheln", "name": "", "type": "tab", "placement": "top" },
            {
              "key": "field_hero_highlight_cards", "label": "Kartenliste", "name": "highlight_cards", "type": "repeater", "min": 1, "max": 3, "layout": "row", "button_label": "Highlight Karte hinzufügen",
              "sub_fields": [
                { "key": "field_card_icon", "label": "Icon (Luicide Name)", "name": "icon_name", "type": "text", "wrapper": { "width": "30" } },
                { "key": "field_card_title", "label": "Titel", "name": "title", "type": "text", "wrapper": { "width": "30" } },
                { "key": "field_card_description", "label": "Beschreibung", "name": "description", "type": "textarea", "rows": 2, "wrapper": { "width": "40" } }
              ]
            }
          ]
        },

        // --- LAYOUT 2: LEISTUNGEN SEKTION (mit zusätzlichen Feldern aus dem Code) ---
        {
          "key": "layout_services_section",
          "name": "services_section",
          "label": "2. Sektion: Unsere Leistungen",
          "display": "block",
          "sub_fields": [
            { "key": "field_services_settings_tab", "label": "Sektionseinstellungen", "name": "", "type": "tab", "placement": "top" },
            { "key": "field_services_title", "label": "Sektions-Titel", "name": "title", "type": "text" },
            { "key": "field_services_subtitle", "label": "Einleitungstext/Untertitel", "name": "subtitle", "type": "textarea", "rows": 2 },
            
